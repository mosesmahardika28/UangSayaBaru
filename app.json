{
  "expo": {
    "name": "UangSaya",
    "slug": "UangSaya",
    "version": "1.0.0",
    "scheme": "uangsaya",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/images/icon.png",
    "plugins": [
      "@react-native-community/datetimepicker",
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "UangSayaWidget",
              "label": "UangSaya Saldo",
              "minWidth": "250dp",
              "minHeight": "100dp",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "6ac6aff4-7be9-4a96-9a85-f93fee97fcd2"
      }
    },
    "android": {
      "package": "com.mosesmahardika.UangSaya",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0097A7"
      }
    }
  }
}
